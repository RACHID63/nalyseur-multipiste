# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Required when using the DeepSeek AI provider.
# Stored securely server-side via Secrets/environment variables (never exposed to browser).
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# ENGINE_ACCESS_PASSWORD: Optional server-side password to lock AI engine selection & execution.
# Leave unset to create/manage the password directly inside the app UI.
ENGINE_ACCESS_PASSWORD="MY_ENGINE_ACCESS_PASSWORD"

# RECOVERY_EMAIL: Registered recovery email used for password reset emails.
RECOVERY_EMAIL="rachid.laieb@gmail.com"

# Email delivery for Forgot Password (configure SMTP or Resend via Settings > Secrets):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="rachid.laieb@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"
SMTP_FROM="rachid.laieb@gmail.com"
# Alternative: RESEND_API_KEY="MY_RESEND_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
